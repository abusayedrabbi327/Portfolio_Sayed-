---
import { cvData } from '../data/cvData';

const featuredResearch = cvData.research.find(r => r.id === 'aegis-fyp') || cvData.research[0];
const otherResearch = cvData.research.filter(r => r.id !== 'aegis-fyp');
---

<section id="research" class="py-20 md:py-32 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <!-- Section Header -->
  <div class="flex flex-col items-center text-center mb-16">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950/50 border border-cyan-500/30 text-cyan-400 text-xs font-mono mb-4">
      <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
      ACADEMIC & APPLIED RESEARCH
    </div>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
      Explainable AI & <span class="text-cyber-cyan">Real-Time Threat Telemetry</span>
    </h2>
    <p class="mt-4 text-base sm:text-lg text-slate-400 max-w-2xl">
      Publishable research solving black-box neural opacity, high false-alarm rates, and high-throughput streaming intrusion telemetry.
    </p>
  </div>

  <!-- Flagship Capstone Research: AEGIS -->
  <div class="cyber-card rounded-3xl p-6 sm:p-9 lg:p-12 border border-cyan-500/30 glow-border relative overflow-hidden mb-12">
    <!-- Top Meta Row -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <div class="flex items-center gap-2.5">
        <span class="px-3.5 py-1 rounded-full bg-cyan-500/20 border border-cyan-500/40 text-cyan-300 font-mono text-xs font-bold uppercase tracking-wider">
          {featuredResearch.category}
        </span>
        <span class="px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 font-mono text-xs font-semibold">
          Status: {featuredResearch.status}
        </span>
      </div>
      <div class="text-xs font-mono text-slate-400">
        Capstone Senior Thesis • {featuredResearch.year}
      </div>
    </div>

    <!-- Title & Abstract -->
    <h3 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white leading-snug">
      {featuredResearch.title}
    </h3>
    <p class="mt-2 text-cyan-400 font-mono text-sm sm:text-base">
      {featuredResearch.tagline}
    </p>

    <div class="mt-6 text-slate-300 text-xs sm:text-sm leading-relaxed bg-slate-950/80 p-5 rounded-2xl border border-slate-800">
      <p class="font-normal text-slate-300">{featuredResearch.abstract}</p>
    </div>

    <!-- Visual Architecture Flow Diagram -->
    {featuredResearch.architectureDiagram && (
      <div class="mt-8">
        <div class="flex items-center justify-between mb-3 text-xs font-mono">
          <span class="text-slate-400 uppercase tracking-wider">
            SYSTEM INFERENCE PIPELINE
          </span>
          <span class="text-cyan-400">&lt; 1.2ms End-to-End Latency</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
          {featuredResearch.architectureDiagram.nodes.map((node, index) => (
            <div class="p-4 rounded-xl bg-slate-950/90 border border-slate-800/90 hover:border-cyan-500/40 transition-all flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between text-[10px] font-mono text-slate-400 mb-1.5">
                  <span>STAGE 0{index + 1}</span>
                  <span class={`px-1.5 py-0.5 rounded uppercase font-bold text-[9px] ${
                    node.type === 'ai' ? 'bg-purple-500/20 text-purple-300 border border-purple-500/30' :
                    node.type === 'process' ? 'bg-blue-500/20 text-blue-300 border border-blue-500/30' :
                    node.type === 'output' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' :
                    'bg-slate-800 text-slate-300'
                  }`}>
                    {node.type}
                  </span>
                </div>
                <h4 class="font-bold text-xs sm:text-sm text-white group-hover:text-cyan-300 transition-colors">
                  {node.label}
                </h4>
                <p class="text-[11px] text-slate-400 mt-1 leading-normal">
                  {node.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Contributions & Empirical Benchmark Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-8">
      <div class="lg:col-span-2 space-y-2.5">
        <h4 class="text-xs font-mono text-slate-400 uppercase tracking-wider mb-2">Key Engineering Innovations</h4>
        <ul class="space-y-2">
          {featuredResearch.contributions.map((contrib) => (
            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-300">
              <span class="text-cyan-400 mt-0.5 font-bold">▹</span>
              <span>{contrib}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col gap-2.5 justify-center bg-slate-950/90 p-5 rounded-2xl border border-slate-800">
        <h4 class="text-xs font-mono text-slate-400 uppercase tracking-wider mb-1">Empirical Benchmark Results</h4>
        {featuredResearch.metrics?.map((metric) => (
          <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-900/60 border border-slate-800/80">
            <div>
              <div class="text-xs text-slate-400">{metric.label}</div>
              {metric.detail && <div class="text-[10px] text-slate-400 font-mono">{metric.detail}</div>}
            </div>
            <div class="font-mono font-black text-base sm:text-lg text-cyan-400">
              {metric.value}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Tags & Code Repo Link -->
    <div class="flex flex-wrap items-center justify-between gap-4 mt-8 pt-6 border-t border-slate-800">
      <div class="flex flex-wrap gap-1.5">
        {featuredResearch.tags.map((tag) => (
          <span class="px-2.5 py-1 rounded bg-slate-950 text-slate-300 text-xs font-mono border border-slate-800">
            #{tag}
          </span>
        ))}
      </div>
      {featuredResearch.codeUrl && (
        <a
          href={featuredResearch.codeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-mono font-semibold bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 transition-all"
        >
          <span>Open AEGIS Repository ↗</span>
        </a>
      )}
    </div>
  </div>

  <!-- Other Research Initiatives Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {otherResearch.map((item) => (
      <div class="cyber-card rounded-2xl p-6 sm:p-7 border border-slate-800 hover:border-cyan-500/30 transition-all flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-2.5 py-0.5 rounded text-xs font-mono font-semibold bg-slate-900 text-cyan-400 border border-slate-800">
              {item.category}
            </span>
            <span class="text-xs font-mono text-slate-400">
              {item.status}
            </span>
          </div>

          <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors">
            {item.title}
          </h3>
          <p class="text-xs font-mono text-cyan-400 mt-1">
            {item.tagline}
          </p>

          <p class="text-xs sm:text-sm text-slate-300 mt-3 leading-relaxed">
            {item.abstract}
          </p>

          {item.metrics && (
            <div class="mt-4 pt-3 border-t border-slate-800 space-y-1.5">
              {item.metrics.map((m) => (
                <div class="flex items-center justify-between text-xs font-mono">
                  <span class="text-slate-400">{m.label}</span>
                  <span class="text-cyan-400 font-bold">{m.value}</span>
                </div>
              ))}
            </div>
          )}
        </div>

        <div class="flex items-center justify-between gap-2 mt-6 pt-4 border-t border-slate-800/80">
          <div class="flex flex-wrap gap-1">
            {item.tags.slice(0, 3).map((tag) => (
              <span class="px-2 py-0.5 rounded bg-slate-950 text-slate-400 text-[10px] font-mono">
                #{tag}
              </span>
            ))}
          </div>

          {item.codeUrl && (
            <a
              href={item.codeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-mono text-cyan-400 hover:text-cyan-300 transition-colors"
            >
              View Code ↗
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
