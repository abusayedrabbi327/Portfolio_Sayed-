---
import { cvData } from '../data/cvData';
---

<section id="cv-section" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-cyan-500/30 relative overflow-hidden text-center max-w-5xl mx-auto">
    <div class="absolute -top-24 -left-24 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-mono mb-6">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <span>CURRICULUM VITAE & CREDENTIALS</span>
    </div>

    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-100 tracking-tight">
      Comprehensive <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Master CV & Resume</span>
    </h2>

    <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Synchronized with <code class="text-cyan-400 font-mono text-xs px-2 py-0.5 rounded bg-slate-900 border border-slate-800">src/data/cvData.ts</code> and LaTeX master source. Ready for academic evaluation, research fellowships, and industry software engineering opportunities.
    </p>

    <!-- Quick Stats in CV Banner -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-8 max-w-3xl mx-auto">
      <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
        <div class="text-xs text-slate-400">Institution</div>
        <div class="font-bold text-sm text-cyan-300">UIU CSE</div>
      </div>
      <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
        <div class="text-xs text-slate-400">Target</div>
        <div class="font-bold text-sm text-cyan-300">AI / Cyber / SWE</div>
      </div>
      <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
        <div class="text-xs text-slate-400">Format</div>
        <div class="font-bold text-sm text-cyan-300">PDF / ATS Clean</div>
      </div>
      <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
        <div class="text-xs text-slate-400">Updated</div>
        <div class="font-bold text-sm text-cyan-300">August 2026</div>
      </div>
    </div>

    <!-- Download & Action Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/Abu_Sayed_Rabbi_CV.pdf"
        download="Abu_Sayed_Rabbi_CV.pdf"
        id="cv-download-btn"
        class="inline-flex items-center gap-2.5 px-8 py-4 rounded-xl text-base font-bold bg-gradient-to-r from-cyan-500 via-sky-400 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-slate-950 shadow-xl shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:-translate-y-0.5 transition-all cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Download Official CV (PDF)</span>
      </a>

      <a
        href={`mailto:${cvData.email}?subject=Research%20or%20Engineering%20Opportunity`}
        class="inline-flex items-center gap-2 px-6 py-4 rounded-xl text-base font-semibold bg-slate-900/80 hover:bg-slate-800 text-slate-200 border border-slate-700 hover:border-cyan-500/50 hover:text-white transition-all cursor-pointer"
      >
        <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Request Custom Dossier</span>
      </a>
    </div>
  </div>
</section>
