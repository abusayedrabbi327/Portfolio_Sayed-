---
import { cvData } from '../data/cvData';
---

<section id="skills" class="py-20 md:py-32 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <!-- Section Header -->
  <div class="flex flex-col items-center text-center mb-16">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950/50 border border-cyan-500/30 text-cyan-400 text-xs font-mono mb-4">
      <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
      FULL-STACK & SYSTEMS ECOSYSTEM
    </div>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
      Technical Capability <span class="text-cyber-cyan">Matrix</span>
    </h2>
    <p class="mt-4 text-base sm:text-lg text-slate-400 max-w-2xl">
      Production tools and core frameworks across machine learning, system programming, full-stack web, and DevOps automation.
    </p>
  </div>

  <!-- Tech Categories Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {cvData.skills.map((categoryGroup) => (
      <div class="cyber-card rounded-2xl p-6 sm:p-7 border border-slate-800/90 hover:border-cyan-500/40 transition-all flex flex-col justify-between group hover:-translate-y-1">
        <div>
          <!-- Group Title -->
          <div class="flex items-center justify-between gap-2 mb-5 pb-3 border-b border-slate-800">
            <h3 class="text-base font-bold text-white group-hover:text-cyan-300 transition-colors flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              <span>{categoryGroup.category}</span>
            </h3>
            <span class="text-[11px] font-mono text-slate-500">
              {categoryGroup.skills.length} tools
            </span>
          </div>

          <!-- Skills Badges -->
          <div class="flex flex-wrap gap-2">
            {categoryGroup.skills.map((skill) => (
              <div class={`px-3 py-1.5 rounded-xl text-xs font-mono transition-all flex items-center gap-1.5 ${
                skill.isPrimary
                  ? 'bg-slate-950 text-cyan-300 border border-cyan-500/40 hover:border-cyan-400 font-semibold shadow-sm'
                  : 'bg-slate-950/70 text-slate-300 border border-slate-800 hover:border-slate-700'
              }`}>
                <span>{skill.name}</span>
                {skill.level === 'Expert' && (
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" title="Expert Proficiency"></span>
                )}
                {skill.level === 'Advanced' && (
                  <span class="w-1.5 h-1.5 rounded-full bg-cyan-400" title="Advanced Proficiency"></span>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Footnote in cards -->
        <div class="mt-6 pt-3 border-t border-slate-800/60 flex items-center justify-between text-[10px] font-mono text-slate-500">
          <span>Module Verified</span>
          <span class="text-cyan-400">Production / Research</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Legend -->
  <div class="flex flex-wrap items-center justify-center gap-6 mt-10 text-xs font-mono text-slate-400">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>Expert / Core Tool</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
      <span>Advanced / Research Tool</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-slate-500"></span>
      <span>Proficient / Applied</span>
    </div>
  </div>
</section>
