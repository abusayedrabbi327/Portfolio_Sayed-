---
import { cvData } from '../data/cvData';
---

<section id="about" class="relative pt-32 pb-20 md:pt-40 md:pb-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="flex flex-col items-center text-center">
    <!-- Live Availability Pill -->
    <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-slate-900/80 border border-cyan-500/30 text-xs font-mono text-cyan-300 backdrop-blur-md shadow-lg shadow-cyan-500/10 mb-8 hover:border-cyan-400/50 transition-all">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <span>{cvData.availability.text}</span>
    </div>

    <!-- Main Title & Name -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-100 max-w-5xl leading-[1.15]">
      Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-500 font-black">{cvData.name}</span>
    </h1>

    <!-- Dynamic Subtitle -->
    <p class="mt-6 text-lg sm:text-xl md:text-2xl text-slate-300 max-w-4xl font-normal leading-relaxed">
      Computer Science & Engineering Undergraduate @ <span class="text-cyan-400 font-semibold">United International University</span>
    </p>

    <p class="mt-3 text-base sm:text-lg text-slate-400 max-w-3xl font-mono leading-relaxed">
      Building <span class="text-slate-200 font-medium">Intelligent Systems</span> at the intersection of <span class="text-cyan-400 font-medium">Explainable AI (XAI)</span>, <span class="text-emerald-400 font-medium">Cyber Defense & Telemetry</span>, and <span class="text-blue-400 font-medium">High-Performance Software</span>.
    </p>

    <!-- Interactive Pillar Badges -->
    <div class="flex flex-wrap justify-center gap-2.5 sm:gap-3 mt-8 max-w-3xl">
      {cvData.badges.map((badge) => (
        <div class="px-3.5 py-1.5 rounded-xl bg-slate-900/70 border border-slate-800 text-slate-300 text-xs sm:text-sm font-medium hover:border-cyan-500/40 hover:text-cyan-300 hover:scale-105 transition-all shadow-sm">
          {badge}
        </div>
      ))}
    </div>

    <!-- Primary Action Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-4 mt-10">
      <a
        href="#research"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-bold bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 shadow-xl shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:-translate-y-0.5 transition-all cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        <span>Explore Research Hub</span>
      </a>

      <a
        href="#projects"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-bold bg-slate-900/80 hover:bg-slate-800/90 text-slate-200 border border-slate-700/80 hover:border-cyan-500/50 hover:text-white hover:-translate-y-0.5 transition-all cursor-pointer"
      >
        <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        <span>View Flagship Projects</span>
      </a>

      <a
        href="#cv-section"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-bold bg-slate-900/80 hover:bg-slate-800/90 text-cyan-400 border border-cyan-500/30 hover:border-cyan-400 hover:text-cyan-300 hover:-translate-y-0.5 transition-all cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Download Master CV</span>
      </a>
    </div>

    <!-- Social Link Badges -->
    <div class="flex items-center justify-center gap-4 mt-8">
      <a
        href={cvData.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="p-2.5 rounded-xl bg-slate-900/60 hover:bg-slate-800 border border-slate-800 hover:border-slate-600 text-slate-400 hover:text-white transition-all hover:scale-110"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <a
        href={cvData.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
        class="p-2.5 rounded-xl bg-slate-900/60 hover:bg-slate-800 border border-slate-800 hover:border-slate-600 text-slate-400 hover:text-cyan-400 transition-all hover:scale-110"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.4 9.74v-8.37H5.06v8.37h2.8z" />
        </svg>
      </a>

      <a
        href={`mailto:${cvData.email}`}
        aria-label="Send Email"
        class="p-2.5 rounded-xl bg-slate-900/60 hover:bg-slate-800 border border-slate-800 hover:border-slate-600 text-slate-400 hover:text-emerald-400 transition-all hover:scale-110"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </a>
    </div>

    <!-- Live Stat Metric Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 mt-16 w-full max-w-5xl">
      {cvData.stats.map((stat) => (
        <div class="glass-panel p-5 rounded-2xl flex flex-col items-center justify-center text-center group hover:-translate-y-1 transition-all">
          <div class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-mono text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400 group-hover:scale-105 transition-transform">
            {stat.value}{stat.suffix}
          </div>
          <div class="text-xs sm:text-sm font-medium text-slate-400 mt-1">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
