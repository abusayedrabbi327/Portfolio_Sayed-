---
import { cvData } from '../data/cvData';
---

<section id="about" class="relative pt-32 pb-20 md:pt-44 md:pb-32 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto overflow-hidden">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
    
    <!-- Left Hero Column (7 Cols) -->
    <div class="lg:col-span-7 flex flex-col items-start text-left">
      <!-- Live Status Pill -->
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-cyan-950/40 border border-cyan-500/30 text-xs font-mono text-cyan-300 backdrop-blur-xl shadow-lg shadow-cyan-500/10 mb-6 hover:border-cyan-400 transition-all">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
        </span>
        <span class="tracking-wide">{cvData.availability.text}</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white leading-[1.08]">
        Engineering <span class="text-cyber-cyan">Intelligent Systems</span> & Cyber Defense.
      </h1>

      <!-- Identity & University -->
      <div class="mt-4 flex items-center gap-3 text-sm sm:text-base font-mono text-slate-300">
        <span class="text-white font-bold text-lg">{cvData.name}</span>
        <span class="text-slate-600">•</span>
        <span class="text-cyan-400">CSE @ United International University</span>
      </div>

      <!-- Bio / Summary -->
      <p class="mt-5 text-base sm:text-lg text-slate-300 font-normal leading-relaxed max-w-2xl">
        Undergraduate engineer specializing in <span class="text-cyan-300 font-medium">Explainable AI (XAI)</span>, <span class="text-emerald-400 font-medium">Real-Time Threat Telemetry</span>, and <span class="text-purple-300 font-medium">High-Throughput Enterprise Software</span>. Creator of <span class="text-white font-semibold">AEGIS</span>, <span class="text-white font-semibold">RT-XNIDS</span>, and 20+ open-source platforms.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3.5 mt-8 w-full sm:w-auto">
        <a
          href="#current-focus"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm font-bold bg-gradient-to-r from-cyan-400 via-sky-400 to-blue-500 hover:from-cyan-300 hover:to-blue-400 text-slate-950 shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:-translate-y-0.5 transition-all cursor-pointer w-full sm:w-auto"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Explore Innovation Radar</span>
        </a>

        <a
          href="#projects"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm font-bold bg-slate-900/80 hover:bg-slate-800 text-slate-200 border border-slate-700/80 hover:border-cyan-500/50 hover:text-white hover:-translate-y-0.5 transition-all cursor-pointer w-full sm:w-auto"
        >
          <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <span>All Projects (20+)</span>
        </a>

        <a
          href="#cv-section"
          class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl text-sm font-bold bg-slate-900/80 hover:bg-slate-800 text-cyan-400 border border-cyan-500/30 hover:border-cyan-400 hover:text-cyan-300 hover:-translate-y-0.5 transition-all cursor-pointer w-full sm:w-auto"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Master CV</span>
        </a>
      </div>

      <!-- Quick Social Icons with Handles -->
      <div class="flex items-center gap-3 mt-8 pt-6 border-t border-slate-800/80 w-full">
        <a
          href={cvData.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900/80 hover:bg-slate-800 text-slate-400 hover:text-white border border-slate-800 hover:border-slate-700 text-xs font-mono transition-all"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>github/abusayedrabbi327</span>
        </a>

        <a
          href={cvData.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900/80 hover:bg-slate-800 text-slate-400 hover:text-cyan-400 border border-slate-800 hover:border-slate-700 text-xs font-mono transition-all"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.4 9.74v-8.37H5.06v8.37h2.8z" />
          </svg>
          <span>LinkedIn</span>
        </a>

        <a
          href={`mailto:${cvData.email}`}
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900/80 hover:bg-slate-800 text-slate-400 hover:text-emerald-400 border border-slate-800 hover:border-slate-700 text-xs font-mono transition-all"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Email</span>
        </a>
      </div>
    </div>

    <!-- Right Hero Column: Interactive Live Telemetry Console (5 Cols) -->
    <div class="lg:col-span-5 w-full">
      <div class="cyber-card rounded-2xl p-5 sm:p-6 border border-slate-800/90 glow-border relative overflow-hidden">
        <!-- Top Window Header -->
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-800">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
          </div>
          <div class="font-mono text-xs text-slate-400 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
            <span>telemetry.sh ~ node:online</span>
          </div>
          <div class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-900 text-cyan-400 border border-slate-800">
            v2.4
          </div>
        </div>

        <!-- Telemetry Stats Grid -->
        <div class="grid grid-cols-2 gap-3 mb-4">
          <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/70">
            <div class="text-[11px] font-mono text-slate-400">IDS BENCHMARK</div>
            <div class="text-xl font-bold font-mono text-cyan-400 mt-1">99.4% ACC</div>
            <div class="text-[10px] text-emerald-400 font-mono mt-0.5">CICIDS2017 Dataset</div>
          </div>

          <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/70">
            <div class="text-[11px] font-mono text-slate-400">INFERENCE LATENCY</div>
            <div class="text-xl font-bold font-mono text-purple-400 mt-1">&lt; 1.2ms</div>
            <div class="text-[10px] text-slate-400 font-mono mt-0.5">Line-rate flows</div>
          </div>

          <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/70">
            <div class="text-[11px] font-mono text-slate-400">PUBLIC CODEBASES</div>
            <div class="text-xl font-bold font-mono text-emerald-400 mt-1">20+ Repos</div>
            <div class="text-[10px] text-slate-400 font-mono mt-0.5">AI, Cyber, Web, Java</div>
          </div>

          <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/70">
            <div class="text-[11px] font-mono text-slate-400">LEADERSHIP</div>
            <div class="text-xl font-bold font-mono text-amber-400 mt-1">4 Orgs</div>
            <div class="text-[10px] text-slate-400 font-mono mt-0.5">UIU ELF, Theater, IT</div>
          </div>
        </div>

        <!-- Live Subsystems Console -->
        <div class="p-3.5 rounded-xl bg-slate-950/80 border border-slate-800/80 font-mono text-xs space-y-2">
          <div class="flex items-center justify-between text-slate-400 pb-1.5 border-b border-slate-900">
            <span class="text-cyan-400">ACTIVE SUBSYSTEMS</span>
            <span class="text-[10px] text-emerald-400">STATUS: RUNNING</span>
          </div>
          <div class="flex items-center justify-between text-slate-300">
            <span>▹ AEGIS (Neural-Symbolic IDS)</span>
            <span class="text-cyan-300 font-semibold">Ready</span>
          </div>
          <div class="flex items-center justify-between text-slate-300">
            <span>▹ Global Mirror AI</span>
            <span class="text-purple-300 font-semibold">Active</span>
          </div>
          <div class="flex items-center justify-between text-slate-300">
            <span>▹ E-CMH Enterprise Hospital</span>
            <span class="text-amber-300 font-semibold">In Dev</span>
          </div>
          <div class="flex items-center justify-between text-slate-300">
            <span>▹ RT-XNIDS Flow Inspector</span>
            <span class="text-emerald-300 font-semibold">120k f/s</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
